{
  "name": "advokatai-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AdvokatAI Monorepo - Legal AI & Legaltech Platform for Uzbekistan",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "client": "npm run dev --prefix frontend",
    "server": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:gh-pages": "npm run build:gh-pages --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "start": "node backend/index.js",
    "preview": "npm run preview --prefix frontend",
    "test": "npm test --prefix backend",
    "test:backend": "npm test --prefix backend"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@supabase/supabase-js": "^2.117.1",
    "clsx": "2.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.15.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
