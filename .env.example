# ============================================================================
# AdvokatAI - Production Environment Configuration Reference (.env.example)
# IMPORTANT: Copy this file to .env for local development.
# NEVER commit real passwords, secrets, or .env files with secrets to GitHub!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PUBLIC / CLIENT-SIDE VARIABLES (Safe for browser)
# ----------------------------------------------------------------------------
# Supabase URL & Publishable Key
NEXT_PUBLIC_SUPABASE_URL=https://gkztwgxxcahwmzwvimzi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CujwKGKQIc70VQo4wQZWXw_r3O3Bhk0
VITE_SUPABASE_URL=https://gkztwgxxcahwmzwvimzi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_CujwKGKQIc70VQo4wQZWXw_r3O3Bhk0

# Optional: Custom API Base URL
# - Leave EMPTY for unified full-stack Render/Railway deployment (same origin).
# - Set only if backend is hosted on a completely separate domain (e.g. https://api.yourdomain.com).
# VITE_API_BASE_URL=

# ----------------------------------------------------------------------------
# 2. SERVER-ONLY PRIVATE SECRETS (NEVER EXPOSE TO BROWSER OR GITHUB)
# ----------------------------------------------------------------------------
# Server Listening Port (Render/Railway automatically assigns PORT)
PORT=5000

# Google Gemini AI API Key (Required for legal AI chatbot)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Dashboard Secret Key
# Required to access /admin and execute administrative endpoints
ADMIN_API_KEY=advokatai_admin_secret_2025

# Cryptographic Session Token Secret (HMAC-SHA256)
# Generate a random 32+ character string
JWT_SECRET=advokatai_jwt_secret_key_2026_super_secure

# Official Payment Card Configuration
PAYMENT_CARD_NUMBER=4466 1369 5151 4448
PAYMENT_CARD_HOLDER=Zokirov Zafar
PAYMENT_BANK_NAME=Humo / Uzcard / Visa

# Supabase Server Service Role Key (OPTIONAL - Server Only)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
# Allows backend to bypass RLS for administrative user and payment verification.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here

# Direct PostgreSQL Connection String (OPTIONAL - Server Only)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.gkztwgxxcahwmzwvimzi.supabase.co:5432/postgres
