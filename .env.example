VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CujwKGKQIc70VQo4wQZWXw_r3O3Bhk0

# Optional: Custom API Base URL
# - Leave EMPTY for unified deployment or same-origin Netlify functions (/api/*).
